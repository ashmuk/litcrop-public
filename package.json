{
  "name": "litcrop",
  "private": true,
  "workspaces": [
    "packages/shared",
    "src/frontend",
    "src/api",
    "src/simulator"
  ],
  "scripts": {
    "dev": "echo 'Use workspace-specific dev commands'",
    "build": "npm run build -w packages/shared && npm run build -w src/frontend -w src/api --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint src/api/src packages/shared/src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shell": "bats scripts/camera-node/__tests__",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=$HOME/.cache/ms-playwright npx playwright test",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=$HOME/.cache/ms-playwright npx playwright test --ui"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@astrojs/preact": {
      "@preact/preset-vite": "2.8.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "bats": "^1.13.0",
    "eslint": "^10.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
