{
  "name": "litcrop",
  "private": true,
  "workspaces": [
    "packages/shared",
    "src/frontend",
    "src/api",
    "src/simulator"
  ],
  "scripts": {
    "dev": "echo 'Use workspace-specific dev commands'",
    "build": "npm run build -w packages/shared && npm run build -w src/frontend -w src/api --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@astrojs/preact": {
      "@preact/preset-vite": "2.8.3"
    }
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  }
}
