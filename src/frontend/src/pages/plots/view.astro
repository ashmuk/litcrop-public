---
/**
 * Plot Detail — deprecated redirect shim
 * Redirects to /beds/view preserving the ?id= query param.
 * Meta refresh covers the no-JS case; the external script adds query preservation.
 *
 * CSP #380: inline script replaced with /scripts/redirect-preserve-query.js.
 */
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/beds/view" />
    <title></title>
    <script
      is:inline
      src="/scripts/redirect-preserve-query.js"
      data-litcrop-redirect
      data-target="/beds/view"
    ></script>
  </head>
  <body style="display:none"></body>
</html>
