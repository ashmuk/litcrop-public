---
/**
 * Plot Detail — deprecated redirect shim
 * Redirects to /beds/view preserving the ?id= query param.
 * No visible content is rendered to avoid a "Plot Detail" flash before redirect.
 */
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/beds/view" id="meta-refresh" />
    <title></title>
    <script is:inline>
      // Preserve query string (e.g. ?id=…) on redirect
      var search = window.location.search;
      if (search) {
        var meta = document.getElementById('meta-refresh');
        if (meta) meta.setAttribute('content', '0;url=/beds/view' + search);
        window.location.replace('/beds/view' + search);
      } else {
        window.location.replace('/beds/view');
      }
    </script>
  </head>
  <body></body>
</html>
