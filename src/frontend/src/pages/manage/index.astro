 * Replaced ManagePage (read-only node list derived from images).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceListPage from '../../components/DeviceListPage';

const farmId = import.meta.env.PUBLIC_FARM_ID ?? 'demo-farm';
---

<BaseLayout title="LitCrop — Device" activeTab="manage" farmNameTitleId="manage-title" farmNamePrefix="📡 ">
  <DeviceListPage farmId={farmId} client:load />
</BaseLayout>
