---
/**
 * Login Page — #335 hero redesign
 * /login — public route (no auth guard)
 *
 * Uses AuthLayout in "hero" variant to bypass the default auth-card shell
 * and own the full split layout (LitCropWordmarkMorph on top/left,
 * LoginForm on the bottom/right).
 */
import AuthLayout from '../layouts/AuthLayout.astro';
import LoginForm from '../components/LoginForm';
import Toast from '../components/Toast';
import LitCropWordmarkMorph from '../components/brand/LitCropWordmarkMorph.astro';
---

<AuthLayout title="Log in" variant="hero">
  <div class="login-split">
    <aside class="login-hero-wrap" aria-hidden="true">
      <LitCropWordmarkMorph variant="animated" />
    </aside>
    <section class="login-form-panel">
      <div class="login-card">
        <h1 class="login-title">Welcome back</h1>
        <p class="login-sub">Sign in to manage your farm</p>
        <LoginForm client:load />
      </div>
    </section>
  </div>
  <Toast client:load />
</AuthLayout>

<style>
  /* ============================================================
     Login page layout — #335
     Mobile (default): stacked hero on top, form below
     Desktop (≥769px): split 60/40 hero left, form right
     ============================================================ */
  .login-split {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
    background: var(--color-background);
  }

  .login-hero-wrap {
    background: var(--color-primary-light);
    aspect-ratio: 1 / 1;
    max-height: 56vh;
    overflow: hidden;
  }

  .login-form-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px 48px;
    background: var(--color-background);
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 36px 28px 32px;
    border: var(--border-default);
  }

  .login-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .login-sub {
    font-size: var(--font-size-base);
    color: var(--color-gray-500);
    margin: 0 0 24px;
  }

  /* ---------- desktop split (≥769px) ---------- */
  @media (min-width: 769px) {
    .login-split {
      grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
      min-height: 100vh;
    }
    .login-hero-wrap {
      aspect-ratio: auto;
      max-height: none;
      height: 100vh;
      border-right: 1px solid var(--color-gray-300);
    }
    .login-form-panel {
      padding: 48px 40px;
    }
  }

  /* ---------- wider desktop (≥1200px) ---------- */
  @media (min-width: 1200px) {
    .login-card {
      max-width: 420px;
    }
  }
</style>
