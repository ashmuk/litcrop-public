---
/**
 * BaseLayout — T-FE-01, T-FE-AUTH-06
 * Mobile-first shell with theme support, i18n locale, and bottom tab navigation.
 * Includes AuthGuard island (protects all pages using this layout).
 */
import '../styles/global.css';
import '../styles/components.css';
import '../styles/auth.css';
import '../styles/responsive.css';
import AuthGuard from '../components/AuthGuard';
import DesktopNav from '../components/DesktopNav';
import AdminTabInjector from '../components/AdminTabInjector';
import NotificationBell from '../components/NotificationBell';
import { PILOT_MODE } from '@litcrop/shared';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ja';
  locale?: 'en' | 'ja';
  theme?: 'light' | 'dark' | 'earthy' | 'system';
  /** Marks the active tab bar item. Defaults to 'farm'. */
  activeTab?: 'farm' | 'weather' | 'diary' | 'manage' | 'setup' | 'admin';
  /** If set, the element with this ID gets its textContent patched with the farm name from localStorage. */
  farmNameTitleId?: string;
  /** Prefix before the farm name (e.g. '🌾 ' or '⛅ Weather — '). */
  farmNamePrefix?: string;
}

const {
  title = 'LitCrop',
  description = 'LitCrop — from soil to signal. Smart crop monitoring for small-scale farms.',
  lang = 'en',
  locale = lang,
  theme = 'system',
  activeTab = 'farm',
  farmNameTitleId,
  farmNamePrefix,
} = Astro.props;

// #410 canonical OG card — reference at docs/screenshots/litcrop-OG.png.
const OG_IMAGE = '/og/og-default.png';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://litcrop.com';
const ogUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImageAbs = `${siteUrl}${OG_IMAGE}`;
---

<!doctype html>
<html
  lang={lang}
  data-theme={theme}
  data-locale={locale}
  data-farm-name-title-id={farmNameTitleId}
  data-farm-name-prefix={farmNamePrefix}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1B6B3A" />
    <meta name="generator" content={Astro.generator} />
    <!-- Mobile web-app meta for fullscreen feel when added to home screen -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title}</title>
    <!-- Favicon set: modern browsers pick the SVG, legacy fall back to PNG,
         iOS home-screen uses apple-touch-icon, PWA installs read the webmanifest. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- #410 OpenGraph + Twitter Card (shared by every BaseLayout route) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LitCrop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LitCrop — from soil to signal" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Restore persisted theme + locale before first paint (flash prevention).
         Externalized for CSP #380 — script-src is 'self' only, no unsafe-inline.
         `is:inline` tells Astro to skip Vite bundling and emit the <script> tag
         verbatim — the script itself stays external (served from public/). -->
    <script is:inline src="/scripts/theme-locale-restore.js"></script>
    <!-- Static-label translation (runs on DOMContentLoaded). -->
    <script is:inline src="/scripts/i18n-labels.js" defer></script>
    {farmNameTitleId && (
      <script is:inline src="/scripts/farm-name-title.js" defer></script>
    )}
  </head>
  <body>
    <!-- Desktop navigation bar (visible at 1024px+ via CSS) -->
    <DesktopNav activeTab={activeTab} client:load />

    <!-- Auth guard: checks token on mount, redirects to /login if unauthenticated -->
    <AuthGuard client:load />

    <!-- Pilot banner — conditionally rendered when PILOT_MODE is true -->
    {PILOT_MODE && (
      <div class="pilot-banner" role="status" data-i18n="nav.pilot_banner">
        PILOT — Release candidate. Your feedback helps shape the product.
      </div>
    )}

    <!-- Page content (provided by each page via slot) -->
    <main class="page-main" role="main">
      <slot />
    </main>

    <!-- Mobile notification bell — floating above tab bar, hidden at desktop (1024px+) -->
    <div class="mobile-notif-bell">
      <NotificationBell variant="mobile" client:load />
    </div>

    <!-- Bottom Tab Bar — mobile-first primary navigation (P2: thumb zone, 64px) -->
    <nav class="tab-bar" role="navigation" aria-label="Main navigation">
      <a
        href="/"
        class={`tab-bar__item${activeTab === 'farm' ? ' tab-bar__item--active' : ''}`}
        aria-label="Crops overview"
        aria-current={activeTab === 'farm' ? 'page' : undefined}
      >
        <span class="tab-bar__icon" aria-hidden="true">🌾</span>
        <span class="tab-bar__label" data-i18n="nav.farm">Crops</span>
      </a>

      <a
        href="/weather"
        class={`tab-bar__item${activeTab === 'weather' ? ' tab-bar__item--active' : ''}`}
        aria-label="Weather"
        aria-current={activeTab === 'weather' ? 'page' : undefined}
      >
        <span class="tab-bar__icon" aria-hidden="true">⛅</span>
        <span class="tab-bar__label" data-i18n="nav.weather">Weather</span>
      </a>

      <a
        href="/diary"
        class={`tab-bar__item${activeTab === 'diary' ? ' tab-bar__item--active' : ''}`}
        aria-label="Farm diary"
        aria-current={activeTab === 'diary' ? 'page' : undefined}
      >
        <span class="tab-bar__icon" aria-hidden="true">📓</span>
        <span class="tab-bar__label" data-i18n="nav.diary">Diary</span>
      </a>

      <a
        href="/manage/"
        class={`tab-bar__item${activeTab === 'manage' ? ' tab-bar__item--active' : ''}`}
        aria-label="Device monitoring"
        aria-current={activeTab === 'manage' ? 'page' : undefined}
      >
        <span class="tab-bar__icon" aria-hidden="true">📡</span>
        <span class="tab-bar__label" data-i18n="nav.manage">Device</span>
      </a>

      <a
        href="/profile/"
        class={`tab-bar__item${activeTab === 'setup' ? ' tab-bar__item--active' : ''}`}
        aria-label="Farm profile"
        aria-current={activeTab === 'setup' ? 'page' : undefined}
      >
        <span class="tab-bar__icon" aria-hidden="true">🌱</span>
        <span class="tab-bar__label" data-i18n="nav.setup">Profile</span>
      </a>
    </nav>

    <!-- Admin tab injector: appends 5th tab to mobile nav when isAdmin cached -->
    <AdminTabInjector active={activeTab === 'admin'} client:load />
  </body>
</html>
