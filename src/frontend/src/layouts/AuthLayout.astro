---
/**
 * AuthLayout — T-FE-AUTH-03 through T-FE-AUTH-05
 * Minimal shell for auth screens: no bottom tab bar, centered card, logo block.
 * Imports auth.css in addition to global styles.
 */
import '../styles/global.css';
import '../styles/components.css';
import '../styles/auth.css';
import '../styles/responsive.css';

export interface Props {
  title?: string;
  /** Page-level heading shown inside the auth card. If omitted, card renders without a title. */
  cardTitle?: string;
  /**
   * Layout variant.
   *   "default" — standard auth-page + auth-logo + auth-card shell (signup, reset, verify)
   *   "hero"    — bare shell; the page owns the full layout (#335 login hero)
   */
  variant?: 'default' | 'hero';
  /** OpenGraph description override. Defaults to the platform tagline. */
  description?: string;
}

const {
  title = 'LitCrop',
  cardTitle,
  variant = 'default',
  description = 'LitCrop — from soil to signal. Smart crop monitoring for small-scale farms.',
} = Astro.props;

// #410 canonical OG card — reference at docs/screenshots/litcrop-OG.png.
const OG_IMAGE = '/og/og-default.png';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://litcrop.com';
const ogUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImageAbs = `${siteUrl}${OG_IMAGE}`;
---

<!doctype html>
<html lang="en" data-theme="earthy" class="auth-route">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6B7F5E" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — LitCrop</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- #410 OpenGraph + Twitter Card (shared by every AuthLayout route) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LitCrop" />
    <meta property="og:title" content={`${title} — LitCrop`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LitCrop — from soil to signal" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — LitCrop`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <!-- Auth routes render data-theme="earthy" via SSR on <html>.
         This script only restores the user's locale preference.
         Externalized for CSP #380 — script-src is 'self' only, no unsafe-inline.
         `is:inline` skips Astro's Vite bundler (the script lives under public/). -->
    <script is:inline src="/scripts/auth-locale-restore.js"></script>
  </head>
  <body class="auth-layout-body">
    {variant === 'hero' ? (
      <slot />
    ) : (
      <main class="auth-page" role="main">
        <!-- Auth card -->
        <div class="auth-card">
          {cardTitle && (
            <h1 class="auth-card__title">{cardTitle}</h1>
          )}
          <slot />
        </div>

        <!-- Legal footer links (#280) -->
        <footer class="auth-footer" style="text-align:center;padding:var(--space-4) 0 var(--space-6);font-size:var(--font-size-xs)">
          <div style="display:flex;justify-content:center;gap:var(--space-4);flex-wrap:wrap">
            <a href="/terms" style="color:var(--color-gray-400);text-decoration:none">Terms</a>
            <a href="/privacy" style="color:var(--color-gray-400);text-decoration:none">Privacy</a>
            <a href="/whats-new" style="color:var(--color-gray-400);text-decoration:none">What's New</a>
          </div>
        </footer>
      </main>
    )}
  </body>
</html>

<style is:global>
  /* Override the 480px body cap (global.css:37) on auth routes only.
     Activates when both html.auth-route AND body.auth-layout-body are
     present — which only happens inside AuthLayout.astro. Non-auth
     pages are unaffected and keep the mobile-first column cap. */
  html.auth-route body.auth-layout-body {
    max-width: none;
    margin: 0;
  }
</style>
