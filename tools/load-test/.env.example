# Copy to .env and fill in values before running `k6 run --env-file .env k6-baseline.js`.
# NEVER commit .env — it is in .gitignore (this .env.example file is intentionally committed).
#
# All sensitive values below are left blank. Populate locally from the staging
# stack outputs or your password manager. Do NOT edit this file to include real
# credentials — edit your private .env instead.

# Staging API base URL (example placeholder — replace with your actual staging endpoint, no trailing slash).
STAGING_API_BASE_URL=https://api-staging.example.com/v1

# Pre-created test user on staging (example placeholder — NOT a production account).
TEST_USER_EMAIL=loadtest+staging@example.com
TEST_USER_PASSWORD=

# Cognito configuration (example placeholders — replace with staging stack outputs).
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-northeast-1

# Optional: pre-fetched admin ID token for the admin-stats scenario.
# If blank, the admin scenario re-uses the test user's credentials and
# will see 403 responses (which still exercise the auth + routing path).
ADMIN_ID_TOKEN=
