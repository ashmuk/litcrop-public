# ──────────────────────────────────────────────────────────────────
# LitCrop Camera Node — Environment Configuration
#
# This file is downloaded from the LitCrop web UI when you register
# a device. Copy it to ~/litcrop/.env on your Raspberry Pi.
#
# All values are in export KEY=VALUE format for bash sourcing.
# ──────────────────────────────────────────────────────────────────

# ── Required (filled in by web UI download) ─────────────────────

export DEVICE_ID=""
export BED_ID=""
export API_BASE_URL="https://<your-api-gateway-url>"
export AUTH_TOKEN=""
export NODE_ID=""

# ── Token refresh ───────────────────────────────────────────────

export REFRESH_TOKEN=""
export COGNITO_CLIENT_ID=""
export AWS_REGION="ap-northeast-1"

# ── Optional (can be left as defaults) ──────────────────────────

# export CAPTURE_WIDTH="1920"
# export CAPTURE_HEIGHT="1080"
# export JPEG_QUALITY="75"
# export TRIGGER="scheduled"
# export MAX_RETRY="3"
