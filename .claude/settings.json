{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "filesystem",
    "git",
    "github",
    "sqlite"
  ],
  "disabledMcpjsonServers": [
    "chrome-devtools",
    "playwright"
  ],

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.devcontainer/.env)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./config/credentials.json)",
      "Read(./config/secrets.*)",
      "Read(./**/*secret*)",
      "Read(./**/*password*)",
      "Read(./**/*token*)",
      "Read(./**/*key.pem)",
      "Read(./**/*.key)"
    ]
  }
}
